# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgres://user:password@host:5432/bookscover?sslmode=require

# Set to "false" only for local Postgres without SSL
DATABASE_SSL=true

# Admin API key (you / admin dashboard / Discord bot). Min 32 chars.
ADMIN_API_KEY=replace-with-64-random-chars

# Game server key (used ONLY by Roblox server scripts). Min 32 chars. Must differ from admin key.
GAME_API_KEY=replace-with-a-different-64-random-chars

PORT=3000
NODE_ENV=development

# Number of reverse proxies in front of the app (Railway/Render = 1, local = 0)
TRUST_PROXY=0
